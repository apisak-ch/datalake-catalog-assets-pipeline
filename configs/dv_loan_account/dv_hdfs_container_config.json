          { "name": "account_subtype_name", "dataType": "STRING" },
          { "name": "market_code", "dataType": "STRING" },
          { "name": "market_code_name", "dataType": "STRING" },
          { "name": "branch_code", "dataType": "STRING" },
          { "name": "branch_code_name", "dataType": "STRING" },
          { "name": "account_status", "dataType": "STRING" },
          { "name": "payment_calculation_method", "dataType": "STRING" },
          { "name": "payment_calculation_method_name", "dataType": "STRING" },
          { "name": "payment_frequency", "dataType": "STRING" },
          { "name": "provision_category", "dataType": "STRING" },
          { "name": "provision_category_name", "dataType": "STRING" },
          { "name": "repayment_method", "dataType": "STRING" },
          { "name": "repayment_method_name", "dataType": "STRING" },
          { "name": "loan_term", "dataType": "STRING" },
          { "name": "contract_date", "dataType": "STRING" },
          { "name": "draw_down_date", "dataType": "STRING" },
          { "name": "maturity_date", "dataType": "STRING" },
          { "name": "restructure_flag", "dataType": "STRING" },
          { "name": "credit_limit", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "ending_balance", "dataType": "STRING", "description": "Numeric value stored as string." },
