{
  "service": "hdfs",
  "containers": [
    {
      "name": "prod",
      "prefix": "/prod/",
      "description": "Root of the prod HDFS environment."
    },
    {
      "name": "raw",
      "parentName": "prod",
      "prefix": "/prod/raw/",
      "description": "Raw zone: straight from FTP, no transform."
    },
    {
      "name": "dv_raw",
      "displayName": "dv",
      "parentName": "raw",
      "prefix": "/prod/raw/dv/",
      "description": "DV (data vendor) source files, shared category folder covering more than just loan account data (e.g. a sibling deposit account information file already lives here) -- not exclusive to dv_loan_account."
    },
    {
      "name": "loan_account_information_raw",
      "displayName": "loan_account_information",
      "parentName": "dv_raw",
      "prefix": "/prod/raw/dv/loan_account_information/",
      "description": "Raw copy of MYMO_LOAN_YYYYMMDD.TXT straight from FTP, before validation. Files land under a daily YYYYMMDD subfolder.",
      "dataModel": {
        "columns": [
          { "name": "part", "dataType": "STRING", "description": "H (header), D (detail), or T (tail) -- HDT file format marker. See dv_ftp_container_config draft notes on this column's name." },
          { "name": "version_date", "dataType": "STRING" },
          { "name": "customer_id", "dataType": "STRING" },
          { "name": "account_number", "dataType": "STRING", "description": "PII -- hashed with MD5 downstream in the safe Hive table." },
          { "name": "account_group", "dataType": "STRING" },
          { "name": "account_group_name", "dataType": "STRING" },
          { "name": "account_type", "dataType": "STRING" },
          { "name": "account_type_name", "dataType": "STRING" },
          { "name": "account_subtype", "dataType": "STRING" },
          { "name": "account_subtype_name", "dataType": "STRING" },
          { "name": "market_code", "dataType": "STRING" },
          { "name": "market_code_name", "dataType": "STRING" },
          { "name": "branch_code", "dataType": "STRING" },
          { "name": "branch_code_name", "dataType": "STRING" },
          { "name": "account_status", "dataType": "STRING" },
          { "name": "payment_calculation_method", "dataType": "STRING" },
          { "name": "payment_calculation_method_name", "dataType": "STRING" },
          { "name": "payment_frequency", "dataType": "STRING" },
          { "name": "provision_category", "dataType": "STRING" },
          { "name": "provision_category_name", "dataType": "STRING" },
          { "name": "repayment_method", "dataType": "STRING" },
          { "name": "repayment_method_name", "dataType": "STRING" },
          { "name": "loan_term", "dataType": "STRING" },
          { "name": "contract_date", "dataType": "STRING" },
          { "name": "draw_down_date", "dataType": "STRING" },
          { "name": "maturity_date", "dataType": "STRING" },
          { "name": "restructure_flag", "dataType": "STRING" },
          { "name": "credit_limit", "dataType": "STRING", "description": "Numeric value stored as string -- see dv_ftp_container_config draft notes." },
          { "name": "ending_balance", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "payment_amount", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "fixed_principal_amount", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "fixed_interest_amount", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "payment_date", "dataType": "STRING" },
          { "name": "last_payment_date", "dataType": "STRING" },
          { "name": "late_charge_effective_date", "dataType": "STRING" },
          { "name": "late_charge_action_date", "dataType": "STRING" },
          { "name": "total_fee", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "grand_total_due", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "penalty_charge", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "interest_due", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "aging_class", "dataType": "STRING" },
          { "name": "auto_payment_account_number", "dataType": "STRING", "description": "PII -- hashed with MD5 downstream in the safe Hive table." },
          { "name": "accrued_interest", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "co_owner", "dataType": "STRING", "description": "Comma-separated CIFs of joint-account co-owners, e.g. 22222,3333" }
        ]
      }
    },
    {
      "name": "cleansed",
      "parentName": "prod",
      "prefix": "/prod/cleansed/",
      "description": "Cleansed zone."
    },
    {
      "name": "dv_cleansed",
      "displayName": "dv",
      "parentName": "cleansed",
      "prefix": "/prod/cleansed/dv/",
      "description": "DV (data vendor) source files, shared category folder -- not exclusive to dv_loan_account."
    },
