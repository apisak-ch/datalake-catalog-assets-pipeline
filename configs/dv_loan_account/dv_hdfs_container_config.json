          { "name": "total_fee", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "grand_total_due", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "penalty_charge", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "interest_due", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "aging_class", "dataType": "STRING" },
          { "name": "auto_payment_account_number", "dataType": "STRING", "description": "PII -- hashed with MD5 downstream in the safe Hive table." },
          { "name": "accrued_interest", "dataType": "STRING", "description": "Numeric value stored as string." },
          { "name": "co_owner", "dataType": "STRING", "description": "Comma-separated CIFs of joint-account co-owners, e.g. 22222,3333" }
        ]
      }
    }
  ]
